### AL ###
#Template for AL projects for Dynamics 365 Business Central
#launch.json folder
.vscode/
#Cache folder
.alcache/
#Symbols folder
.alpackages/
#Snapshots folder
.snapshots/
#Testing Output folder
.output/
#Extension App-file
*.app
#Rapid Application Development File
rad.json
#Translation Base-file
*.g.xlf
#License-files
*.bclicense
*.flf
#Test results file
TestResults.xml
# Die Shift Analyze runtime and build outputs
__pycache__/
*.py[cod]
.venv*/
build/
dist/
logs/
startup-error.log
results/*.log

# Versioned project result sidecars are user data, not source
*.dsresults

ipc/
.dsa-batch-*/
.rda-import-*/
RealDataAnalyse-output/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.lock

# Project-owned runs are private; reviewed Jobs/GD55 inputs are versioned.
Jobs/**/Cache/
Jobs/**/Tasks/
Jobs/**/Output/
Jobs/**/RealDataAnalyse.project.json
!Jobs/GD55/RealDataAnalyse/RealDataAnalyse.project.json
!Jobs/SH22/RealDataAnalyse/RealDataAnalyse.project.json

Jobs/.RealDataAnalyse/
